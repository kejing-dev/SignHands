<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">手语老师</string>
    <!-- v0.1.6（profile B19）：设置 > 怎么操作。每个主动作一行：用手怎么做、用手柄怎么做。 -->
    <string name="how_to_title">怎么操作</string>
    <string name="how_to_watch">看示范</string>
    <string name="how_to_watch_hand">老师的手在窗口旁边做动作；拖页面上的「转动」滑杆，可以换个角度看。</string>
    <string name="how_to_watch_pad">射线指着滑杆，按住扳机左右拖。</string>
    <string name="how_to_follow">跟着做</string>
    <string name="how_to_follow_hand">把手举到半透明的老师手里照着摆，摆对了自动进下一个。</string>
    <string name="how_to_follow_pad">跟做要用手：先把手柄放下。</string>
    <string name="how_to_tap">点按钮</string>
    <string name="how_to_tap_hand">看着或指着按钮，手指捏一下。</string>
    <string name="how_to_tap_pad">射线指向按钮，按扳机。</string>
    <string name="how_to_panel">面板</string>
    <string name="how_to_panel_hand">窗口下面的小圆点：拖动、关闭、收起。关掉后点「打开面板」。</string>
    <string name="how_to_panel_pad">按 B 把关掉的面板叫回来。</string>
    <string name="how_to_back">返回</string>
    <string name="how_to_back_hand">点窗口左上角的 ‹。</string>
    <string name="how_to_back_pad">按 B 返回上一页。</string>
</resources>
